{
  "name": "dsh-kicad-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:py": "cd packages/kicad-bridge/sidecar && uv run --extra dev pytest -q",
    "test:all": "pnpm run build && pnpm test && pnpm run test:py"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
